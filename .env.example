# Port the server listens on
PORT=3000

# Postgres connection string from your cloud provider (Neon, Supabase, Railway,
# Render, RDS, ...), e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Set to "disable" only if connecting to a local Postgres with no TLS at all.
# Leave unset for any hosted/managed Postgres (they all require TLS).
PGSSL=

# Admin panel password (/admin). If unset, a random one is generated at
# startup and printed to the console — it changes on every restart.
ADMIN_PASSWORD=

# 32-byte AES-256 key, as 64 hex characters, used to encrypt submissions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a key is generated and stored in data/.encryption-key on first run.
SUBMISSIONS_ENCRYPTION_KEY=

# Secret used to sign admin session cookies. If unset, one is generated and
# stored in data/.session-secret on first run.
SESSION_SECRET=
